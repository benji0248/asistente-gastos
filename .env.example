# Frontend environment (optional)
# Vite dev server proxies /api/v1/auth → identity-api (127.0.0.1:3001)
# and /api → gastos-api (127.0.0.1:3002). No Supabase variables are required.

# Optional public app URL (auth redirects, links)
# VITE_APP_URL=http://localhost:5173

# Optional override for Gmail bank-import webhook URL shown in profile settings.
# Defaults to `${window.location.origin}/api/v1/email-import/bank-import`
# VITE_BANK_IMPORT_URL=http://localhost:5173/api/v1/email-import/bank-import
