    "@radix-ui/react-tabs": "^1.1.15",
    "@supabase/supabase-js": "^2.49.1",
    "@types/js-cookie": "^3.0.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.3",
    "class-variance-authority": "^0.7.1",
